{
  "name": "@himetrica/replaykit",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himetrica/himetrica-replaykit.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./global": "./dist/replaykit.global.js"
  },
  "sideEffects": [
    "./dist/replaykit.global.js"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && ([ ! -f tsconfig.compat.json ] || tsc --noEmit -p tsconfig.compat.json)",
    "test": "node --import tsx --test src/replaykit.test.ts"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
